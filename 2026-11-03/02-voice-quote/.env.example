# Copy this file to .env (same folder) and fill in your own values. .env is ignored by git.
#
# Connect any LLM. Make a key just for this app and set a monthly spend limit on it at your provider.
#   LLM_API_STYLE  anthropic or openai: the API format your provider uses (most offer one of the two)
#   LLM_API_KEY    your key
#   LLM_MODEL      a model name from your provider's model list. It must read images if you add photos
#   LLM_BASE_URL   leave blank, unless your provider gives you its own address for one of the two formats
LLM_API_STYLE=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional. These are the defaults.
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo-q5_0.bin   (default: .cache/whisper-cpp in your home folder)
# FFMPEG=ffmpeg
# PORT=8787
